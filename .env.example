# VITE_API_BASE_URL: Backend base URL. Defaults to '/v1' (same-origin proxy).
# Production: https://api.eurosolservice.com/v1
VITE_API_BASE_URL="https://api.eurosolservice.com/v1"

# Sentry (browser) — set DSN to enable error/performance reporting; leave empty to disable.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENV="production"
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0"
